#!/usr/bin/env python3
"""
pam-watch-proximity
PAM authentication helper for watch-proximity.
Grants instant passwordless authentication if and only if:
1. Proximity daemon is running and state is DESK (> +1 dB).
2. Telemetry is fresh (updated within 4 seconds).
3. The smartwatch is physically ON-WRIST.
4. The smartwatch is UNLOCKED (PIN entered).

Exits 0 on success, 1 on failure/rejection (falling back to fprintd / password).
"""

import os
import sys
import time
import json
import pwd
from pathlib import Path


def get_target_uid() -> int:
    """Determine UID of the calling user requesting authentication."""
    # 1. PAM_RUSER is set by pam_exec to the requesting user (e.g. 'mambuco')
    # 2. SUDO_USER is set when running under sudo
    for var in ("PAM_RUSER", "SUDO_USER"):
        user = os.environ.get(var)
        if user and user != "root":
            try:
                return pwd.getpwnam(user).pw_uid
            except KeyError:
                pass

    # 3. If PAM_USER is set and NOT root, use it (e.g. graphical login / screen unlock)
    user = os.environ.get("PAM_USER")
    if user and user != "root":
        try:
            return pwd.getpwnam(user).pw_uid
        except KeyError:
            pass

    # 4. If called by root without env, check active logged-in graphical user in /run/user
    try:
        users = [int(p.name) for p in Path("/run/user").iterdir() if p.name.isdigit() and int(p.name) >= 1000]
        if users:
            return users[0]
    except Exception:
        pass

    return 1000


def main():
    uid = get_target_uid()
    status_file = Path(f"/run/user/{uid}/bt-proximity-status.json")

    def fail(reason: str, d=None):
        try:
            with open("/tmp/pam-debug.log", "a") as f:
                f.write(f"[{time.strftime('%X')}] FAIL: {reason} | uid={uid} | data={d}\n")
        except Exception:
            pass
        sys.exit(1)

    if not status_file.exists():
        fail(f"Status file {status_file} does not exist")

    try:
        data = json.loads(status_file.read_text(encoding="utf-8"))
    except Exception as e:
        fail(f"Failed to parse JSON: {e}")

    # 1. Freshness check: daemon must be actively polling (within 10s)
    now = time.time()
    updated_at = data.get("updated_at", 0)
    if (now - updated_at) > 10.0 or (updated_at > now + 3.0):
        fail(f"Stale telemetry: now={now} updated_at={updated_at} diff={now - updated_at}", data)

    # 2. Zone check: user must be at Desk (> +1 dB)
    if data.get("state") != "DESK":
        fail(f"Not in DESK zone: state={data.get('state')}", data)

    # 3. Connection check
    if not data.get("connected"):
        fail("Device not connected", data)

    # 4. Laptop lock check: cannot authenticate while screen is locked
    if data.get("is_locked"):
        fail("Screen is locked", data)

    # 5. Alarm check: cannot authenticate if anti-theft siren is active
    if data.get("alarm_active"):
        fail("Anti-theft alarm active", data)

    # 6. Watch Security Telemetry:
    # Must be confirmed unlocked (PIN entered) AND confirmed on-body (on wrist)
    watch_unlocked = data.get("watch_unlocked")
    watch_on_body = data.get("watch_on_body")

    # If telemetry is reporting, enforce strictly (reject if locked or off-wrist):
    if watch_unlocked is False:
        fail("Watch is locked", data)

    if watch_on_body is False:
        fail("Watch is off-body", data)

    try:
        with open("/tmp/pam-debug.log", "a") as f:
            f.write(f"[{time.strftime('%X')}] SUCCESS: auto-unlock authorized for uid={uid}\n")
    except Exception:
        pass

    # All criteria satisfied!
    sys.exit(0)


if __name__ == "__main__":
    main()
